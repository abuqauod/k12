# This directory holds several unrelated projects; this repo is only
# ArrangeMySchool's backend and frontend (plus CI). Ignore everything at the
# top level except those.
/*
!/server
!/timetable-ui
!/docs
!/.gitignore

# .github holds other tools' data too (e.g. prompts/) — only workflows/ is
# actually part of this repo.
!/.github
/.github/*
!/.github/workflows
