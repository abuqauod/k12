# Copy to .env and change every secret before this leaves your machine.
#
# Two ways to use this file:
#
# A) Docker Compose (docker-compose.yml reads these directly) — the whole
#    stack self-hosted on your own server/VPS: MongoDB, the API, and Caddy
#    for automatic HTTPS. Point API_DOMAIN's DNS at this machine first.
MONGO_ROOT_PASSWORD=mongo_root_password
DB_PORT=27018
API_PORT=4000
API_DOMAIN=api.your-domain.com
#
# B) Shared hosting / a managed MongoDB you're pointing the app at (e.g.
#    MongoDB Atlas's free tier — most shared hosts, Hostinger included, don't
#    offer MongoDB natively, so this is the normal path there). Atlas gives
#    you a connection string that looks like this — use it as-is:
# DATABASE_URL=mongodb+srv://user:pass@cluster.xxxxx.mongodb.net/timetable?retryWrites=true&w=majority

# Required everywhere:
JWT_SECRET=generate-with-openssl-rand-base64-48
CORS_ORIGINS=http://localhost:5173,http://localhost:5183

# Optional, sensible defaults shown:
# PORT=4000                  # shared hosts (Passenger/cPanel/hPanel) usually set this for you — leave unset
# HOST=0.0.0.0
# ACCESS_TOKEN_TTL=15m
# REFRESH_TOKEN_DAYS=30
# MAX_BODY_BYTES=8388608
# MONGO_POOL_MAX=20          # Atlas free tier caps total connections — lower this if you hit that limit

# Only set this if the app is reachable under a path rather than its own
# subdomain — e.g. Hostinger's Node.js Selector with Application URL set to
# yourdomain.com/api instead of a separate api.yourdomain.com. Passenger-style
# setups forward the full path *including* that prefix, so the app needs to
# expect it too, or every route 404s. Leave unset for a dedicated subdomain
# or a bare host:port (Docker/VPS, or hitting the app directly).
# ROUTE_PREFIX=/api

# Where invite / password-reset links point (the frontend, not this API).
# Defaults to the first entry in CORS_ORIGINS if unset.
# APP_URL=https://your-frontend-domain.com

# SMTP — required for invite emails and password reset; everything else works
# without it. Example for a Hostinger mailbox (Hostinger → Emails → the
# mailbox → Configure email client gives you the exact host):
# SMTP_HOST=smtp.hostinger.com
# SMTP_PORT=465
# SMTP_USER=noreply@your-domain.com
# SMTP_PASS=the-mailbox-password
# SMTP_FROM="School Name <noreply@your-domain.com>"   # defaults to SMTP_USER if unset
# SMTP_SECURE=true   # optional; defaults to true on port 465, STARTTLS otherwise
# A relay that needs no login (a local Postfix, an office relay): leave
# SMTP_USER/SMTP_PASS out and set SMTP_FROM.
#
# The same SMTP sends family notices (absences, fee reminders, receipts,
# announcements…) and scheduled report emails. Check it from the app:
# Communication → Automatic notices → Delivery channels → Send test. Messages
# that failed before it was set up can be re-sent from the Delivery log.

# SMS — optional. Without it, SMS notices end in the delivery log as
# SMS_NOT_CONFIGURED. Numbers are stored as typed; set the country code so
# local numbers ("079…") are sent in international form ("+96279…").
# SMS_DEFAULT_COUNTRY_CODE=962
#
# Twilio:
# SMS_PROVIDER=twilio
# TWILIO_ACCOUNT_SID=ACxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
# TWILIO_AUTH_TOKEN=your-auth-token
# TWILIO_FROM=+15550001111        # or a Messaging Service SID (MG…)
#
# Any other HTTP SMS gateway: receives POST {"to","body","from"} as JSON,
# with "Authorization: Bearer <token>" when a token is set; any 2xx is a send
# (a JSON "id" or "messageId" in the reply is kept as the message id).
# SMS_PROVIDER=webhook
# SMS_WEBHOOK_URL=https://sms-gateway.example.com/send
# SMS_WEBHOOK_TOKEN=secret
# SMS_FROM=SCHOOL                 # sender name/number passed to the gateway
#
# Development only (prints instead of sending):
# SMS_PROVIDER=log

# --- Production operations (SAMS 8) ---------------------------------------
# A production start (NODE_ENV=production) refuses to run with the default
# or a short JWT_SECRET, or the default MongoDB password, and logs a warning
# for local APP_URL/CORS_ORIGINS, no backups, and which channels are off.

# Backups: the `backup` service in docker-compose.yml dumps the database
# daily into ./backups (BACKUP_HOST_DIR) and keeps BACKUP_KEEP_DAYS.
# BACKUP_DIR=/backups
# BACKUP_KEEP_DAYS=14
# BACKUP_FIRST_DELAY_S=3600
# BACKUP_INTERVAL_S=86400
# Off-site copy to any S3-compatible storage (AWS S3, Cloudflare R2,
# Wasabi, Backblaze B2, MinIO):
# BACKUP_S3_BUCKET=s3://your-bucket/sams
# BACKUP_S3_ENDPOINT=https://<account>.r2.cloudflarestorage.com
# AWS_ACCESS_KEY_ID=...
# AWS_SECRET_ACCESS_KEY=...
# AWS_DEFAULT_REGION=auto

# Error reporting to Sentry, GlitchTip or self-hosted Sentry (optional):
# ERROR_REPORTING_DSN=https://<key>@<host>/<project>
# ERROR_REPORTING_ENV=production
# APP_RELEASE=2026.09.26        # shown in /ready and on reported errors

# Per-IP limits on public endpoints (requests per window); RATE_LIMITS=off
# disables them (tests, load tests only).
# RATE_LIMIT_AUTH=60            # sign-in, password reset, invites, per minute
# RATE_LIMIT_REFRESH=600        # token refresh, per minute
# RATE_LIMIT_EMAIL=10           # "forgot password" emails, per 15 minutes
# SHUTDOWN_GRACE_MS=10000       # how long a deploy waits for requests in flight

# --- Online fee payment (SAMS 11.1) ---------------------------------------
# Each school enters its own PayTabs or HyperPay keys in Settings → Online
# payments; they are stored encrypted with this key (32 bytes, base64:
# `openssl rand -base64 32`). Unset, a key derived from JWT_SECRET is used.
# Changing it means schools re-enter their gateway keys.
# PAYMENTS_SECRET_KEY=
# This API's public https address, for the gateway's return and callback
# links (defaults to the address a request came in on) and for the sweep
# that checks payments a family never came back from.
# PUBLIC_API_URL=https://api.your-domain.com
# The test gateway (no card charged) is off in production unless:
# PAYMENTS_ALLOW_TEST=true

# --- Selling the service (SAMS 13) ------------------------------------------
# Public trial sign-up at /signup (on unless set to off).
# SIGNUP=off
# Where "new trial" notices go, and the address shown to schools for billing.
# SALES_NOTIFY_EMAIL=sales@your-company.com
# SALES_EMAIL=billing@your-company.com
# The vendor's own card gateway for subscription payments — separate from the
# schools' gateways above: paytabs, hyperpay, or test (development only).
# VENDOR_PAYMENT_PROVIDER=paytabs
# VENDOR_PAYTABS_PROFILE_ID=
# VENDOR_PAYTABS_SERVER_KEY=
# VENDOR_PAYTABS_REGION=jordan
# VENDOR_HYPERPAY_ENTITY_ID=
# VENDOR_HYPERPAY_ACCESS_TOKEN=
# VENDOR_HYPERPAY_MODE=live
# VENDOR_HYPERPAY_BRANDS=VISA MASTER MADA
# On the vendor's invoices (printed by schools from Settings → Subscription).
# VENDOR_NAME=Your Company LLC
# VENDOR_ADDRESS=Street, City, Country
# VENDOR_TAX_NUMBER=
# VENDOR_BANK_DETAILS="Bank: …\nIBAN: …\nSWIFT: …"
# Sales tax on subscription invoices by the school's country, in percent
# (defaults JO 16, SA 15, AE 5 — confirm with your accountant).
# VENDOR_TAX_RATES={"JO":16,"SA":15,"AE":5}
